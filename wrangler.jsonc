{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lecturer-admin",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lecturer-student-admin-db",
      "database_id": "---",
      "migrations_dir": "migrations"
    }
  ]
}

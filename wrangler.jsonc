{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lecturer-admin-cloudflare",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lecturer-student-admin-db",
      "database_id": "c9d42ff7-fa36-40dc-96db-ddcb146d8ee3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ADMIN_USERNAME": "admin"
  }
}
